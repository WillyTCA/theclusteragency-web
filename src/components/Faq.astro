---
// Pinta las preguntas Y genera el JSON-LD FAQPage desde los mismos datos.
// La respuesta va siempre en el HTML (details abierto o cerrado) para que Google y las IAs la lean.
interface Item { q: string; a: string }
interface Props { items: Item[] }
const { items } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---
<section aria-labelledby="faq-t">
  <h2 id="faq-t">Preguntas, algunas no tan frecuentes</h2>
  {items.map((i) => (
    <details>
      <summary>{i.q}</summary>
      <p>{i.a}</p>
    </details>
  ))}
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
